# Скопируйте в .env (файл .env не коммитится) и заполните значения.
APP_ENV=production            # production | development | testing
APP_DEBUG=0
APP_URL=https://paddisp.ru
APP_TIMEZONE=Asia/Vladivostok

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Защита входа: после LOGIN_MAX_FAILURES неудачных попыток за LOGIN_WINDOW_MINUTES
# логин блокируется до конца окна. С одного IP допускается LOGIN_MAX_IP_FAILURES.
LOGIN_MAX_FAILURES=5
LOGIN_MAX_IP_FAILURES=20
LOGIN_WINDOW_MINUTES=15

# Интеграция MAX пока не реализована; токены хранятся только здесь, не в GitHub.
MAX_ENABLED=0
MAX_BOT_TOKEN=
